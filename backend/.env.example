# Database connection string used by Prisma.
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"

# PostgreSQL alternative — switch the provider in prisma/schema.prisma to "postgresql" first:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quiz_builder?schema=public"

# HTTP port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"
